<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cameras that talk PTP / MTP over USB (Nikon, Canon, Sony...) -->
    <usb-device class="6" subclass="1" protocol="1" />
    <usb-device vendor-id="1200" />   <!-- Nikon -->
    <usb-device vendor-id="1193" />   <!-- Canon -->
    <usb-device vendor-id="1356" />   <!-- Sony -->

    <!-- USB webcams (UVC = USB Video class 14): Logitech Brio / C270 / C920 and others -->
    <usb-device class="14" />
    <usb-device vendor-id="1133" />   <!-- Logitech (0x046D) -->

    <!--
        Epson ink-tank photo & AIO printers (Seiko Epson Corp. Vendor ID 1208 / 0x04B8)
        Product IDs (decimal):
          - Epson L8050: 2150 (0x0866)
          - Epson L3210: 58993 (0xE671)
          - Epson L3276: 17498 (0x445A)
          - Epson L120 / L121: 94 (0x005E)
    -->
    <usb-device vendor-id="1208" product-id="2150" />
    <usb-device vendor-id="1208" product-id="58993" />
    <usb-device vendor-id="1208" product-id="17498" />
    <usb-device vendor-id="1208" product-id="94" />

    <!--
        Canon PIXMA G-series ink-tank printers (Canon Inc. Vendor ID 1193 / 0x04A9)
        Product IDs (decimal):
          - Canon G1010: 6204 (0x183C)
          - Canon G1000: 6035 (0x1793)
          - Canon G2010: 6205 (0x183D)
          - Canon G2000: 6037 (0x1795)
          - Canon G3010: 6203 (0x183B)
          - Canon G3000: 6036 (0x1794)
          - Canon G3020: 6335 (0x18BF)
          - Canon G3060: 6336 (0x18C0)
          - Canon G3070: 6408 (0x1908)
          - Canon G3030: 6510 (0x196E)
    -->
    <usb-device vendor-id="1193" product-id="6204" />
    <usb-device vendor-id="1193" product-id="6035" />
    <usb-device vendor-id="1193" product-id="6205" />
    <usb-device vendor-id="1193" product-id="6037" />
    <usb-device vendor-id="1193" product-id="6203" />
    <usb-device vendor-id="1193" product-id="6036" />
    <usb-device vendor-id="1193" product-id="6335" />
    <usb-device vendor-id="1193" product-id="6336" />
    <usb-device vendor-id="1193" product-id="6408" />
    <usb-device vendor-id="1193" product-id="6510" />

    <!--
        Epson TM / EU receipt printers (VID 0x04B8 = 1208 decimal)
        Product IDs (decimal):
          - TM-T82X / TM-T82X-II (USB Printer Class mode):  3623  (0x0E27)
          - TM-T82X / TM-T82X-II (Vendor-Defined Class):     514  (0x0202)
          - EU-m30 kiosk module  (USB Printer Class mode):  3630  (0x0E2E)
          - EU-m30 kiosk module  (Vendor-Defined Class):     514  (0x0202, shared with TM series)
    -->
    <usb-device vendor-id="1208" product-id="3623" />   <!-- Epson TM-T82X-II (printer class) -->
    <usb-device vendor-id="1208" product-id="514" />    <!-- Epson TM / EU-m30 (vendor-defined) -->
    <usb-device vendor-id="1208" product-id="3630" />   <!-- Epson EU-m30 (printer class) -->

    <!--
        DNP dye-sub photo printers (printed straight over USB by DnpJob.kt)
          - DS40 / DS80 / DS-RX1 / RX1HS use Citizen's vendor id 0x1343 (4931)
          - DS620 / DS620A / DS820 use DNP's vendor id 0x1452 (5202)
    -->
    <usb-device vendor-id="4931" />
    <usb-device vendor-id="5202" />

    <!-- General printer class (class 7 = USB printer: Epson, Canon SELPHY, thermal receipt, etc.) -->
    <usb-device class="7" />
    <usb-device vendor-id="1208" />   <!-- Epson (all models, catch-all) -->
    <usb-device vendor-id="1273" />   <!-- Brother (0x04F9) -->

    <!--
        Star Micronics receipt printers (VID 0x0519 = 1305 decimal)
        Product IDs (decimal):
          - TSP143IIIU / TSP100IIIU:  3  (0x0003)
          - mC-Print2 / mC-Print3:   7  (0x0007)
        ⚠ Must have ESC/POS routing enabled via Star futurePRNT Configuration Utility.
    -->
    <usb-device vendor-id="1305" product-id="3" />   <!-- Star TSP143IIIU -->
    <usb-device vendor-id="1305" product-id="7" />   <!-- Star mC-Print2/3 -->
    <usb-device vendor-id="1305" />                  <!-- Star (all models, catch-all) -->

    <!--
        Xprinter thermal receipt printers (VID 0x28e9 = 10473 decimal, GigaDevice chipset)
        Covers: XP-T80Q, XP-P300, XP-80C, and most Xprinter USB receipt models.
        PIDs vary by firmware batch; the VID alone is used for auto-attach.
    -->
    <usb-device vendor-id="10473" />   <!-- Xprinter / GigaDevice (XP-T80Q, XP-P300, etc.) -->
</resources>

