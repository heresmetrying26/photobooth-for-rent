<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Epson ink-tank printers supported for direct USB printing.
        vendor-id / product-id must be DECIMAL (Android requirement).
        Vendor 1208 = 0x04B8 (Seiko Epson Corp.)

        Model          PID (hex)   PID (dec)   Protocol
        ─────────────────────────────────────────────────
        Epson L8050    0x0866      2150        ESC/P-R  (photo 6-ink)
        Epson L3210    0xE671      58993       ESC/P-R  (mono/colour)
        Epson L3276    0x445A      17498       ESC/P-R  (L3270-family, Wi-Fi model)
    -->
    <usb-device vendor-id="1208" product-id="2150" />   <!-- L8050  -->
    <usb-device vendor-id="1208" product-id="58993" />  <!-- L3210  -->
    <usb-device vendor-id="1208" product-id="17498" />  <!-- L3276  -->

    <!-- Fallback: any Epson USB printer class device (class 7 = printer) -->
    <usb-device vendor-id="1208" />
</resources>

