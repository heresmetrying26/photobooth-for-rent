{
  "name": "photo-booth-rental",
  "private": true,
  "version": "1.0.0",
  "description": "Photo booth with rental lock (trial + one-time day-based codes) and admin panel",
  "scripts": {
    "build": "node scripts/build-booth.mjs && node scripts/build-rush.mjs",
    "check:booth": "node scripts/assemble-booth.mjs --check",
    "test:camera": "node scripts/test-camera-quality.mjs",
    "test:camera-worker": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/print-helper/test-camera-worker.ps1",
    "test:chroma": "node scripts/test-chroma-key.mjs",
    "test:instax": "node scripts/test-instax.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  }
}
